# Copy this file to .streamlit/secrets.toml (local) or paste its content into
# Streamlit Cloud -> App -> Settings -> Secrets. NEVER commit the real secrets.toml.

# ---- AI models (free) - at least one is recommended -------------------------
GROQ_API_KEY = ""          # https://console.groq.com  (LLM + Whisper speech-to-text)
GEMINI_API_KEY = ""        # https://aistudio.google.com/apikey
# OPENROUTER_API_KEY = ""  # optional backup (free models)
# ASSEMBLYAI_API_KEY = ""  # optional: speaker identification for audio

# ---- Optional model overrides (if a free model name is retired) --------------
# GROQ_MODEL = "llama-3.3-70b-versatile"
# GEMINI_MODEL = "gemini-2.5-flash"

# ---- Email (Minutes of Meeting + follow-ups) --------------------------------
# For Gmail create an App Password: Google Account -> Security -> 2-Step Verification -> App passwords
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_USER = "you@gmail.com"
# SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"

# ---- Protect a public deployment with a password ----------------------------
# APP_PASSWORD = "choose-a-strong-password"
